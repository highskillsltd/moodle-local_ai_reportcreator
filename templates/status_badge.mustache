{{!
    @template local_ai_reportcreator/status_badge

    A single pipeline-stage status badge (pending / running / done),
    rendered client-side by amd/src/create.js via core/templates and
    swapped into a progress-table row's .status-badge cell.

    Classes required for JS: none.
    Data attributes required for JS: none.

    Context variables required for this template:
    * ispending - boolean, true for the initial "not started yet" spinner
    * isrunning - boolean, true while the stage is in progress
    * isdone - boolean, true once the stage has completed
    * label - text shown next to the running spinner, or inside the done badge (unused when ispending)

    Example context (json):
    {
        "ispending": false,
        "isrunning": true,
        "isdone": false,
        "label": "Running…"
    }
}}
{{#ispending}}<span class="spinner-grow spinner-grow-sm text-secondary" role="status"></span>{{/ispending}}
{{#isrunning}}<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{label}}{{/isrunning}}
{{#isdone}}<span class="badge bg-success">{{label}}</span>{{/isdone}}
