{{!
    @template local_ai_reportcreator/testconnection_setting

    The "Test Connection" button rendered on the plugin's admin settings
    page. amd/src/testconnection.js binds to #local-ai-testconn-btn and
    #local-ai-testconn-result by id.

    Classes required for JS: none.
    Data attributes required for JS: none.

    Context variables required for this template:
    * btnlabel - label for the test-connection button

    Example context (json):
    {
        "btnlabel": "Test Connection"
    }
}}
<div class="form-item row">
    <div class="form-label col-sm-4 col-form-label d-flex pb-0 pr-md-0">{{btnlabel}}</div>
    <div class="form-setting col-sm-8">
        <button type="button" class="btn btn-secondary" id="local-ai-testconn-btn">{{btnlabel}}</button>
        <span id="local-ai-testconn-result" class="align-middle ms-2"></span>
    </div>
</div>
