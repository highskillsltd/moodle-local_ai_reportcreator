<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ai_reportcreator/db" VERSION="20240101"
       COMMENT="XMLDB file for local_ai_reportcreator"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_ai_reportcreator_rpts" COMMENT="Stores AI-generated reports">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name"             TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="nl_request"       TYPE="text"              NOTNULL="true"/>
        <FIELD NAME="template_type"    TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="report"/>
        <FIELD NAME="sql_query"        TYPE="text"              NOTNULL="true"/>
        <FIELD NAME="template_html"    TYPE="text"              NOTNULL="true"/>
        <FIELD NAME="semantics_json"   TYPE="text"              NOTNULL="false"/>
        <FIELD NAME="embed_token"      TYPE="char" LENGTH="40"  NOTNULL="true"/>
        <FIELD NAME="tokens_prompt"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tokens_completion" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tokens_total"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="generation_ms"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
